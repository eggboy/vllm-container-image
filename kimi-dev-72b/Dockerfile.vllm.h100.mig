# =============================================================================
# Dockerfile.vllm.h100.mig — Serve Kimi-Dev-72B (AWQ INT4) via vLLM on an
# H100 MIG slice (3g.47gb). Vendor-A model in the Kimi-vs-Qwen test (Option B).
#
# Moonshot Kimi-Dev-72B: dense 72B SWE/coding model (Qwen2.5-72B architecture).
# This INT4 AWQ build (cyankiwi/Kimi-Dev-72B-AWQ-4bit, ~40 GB) is what lets a 72B
# model fit ONE 47 GB MIG slice. NOT the 1T-param Kimi-K2 (un-self-hostable here).
# served-model-name "Kimi-Dev-72B". hermes tool-call parser for Copilot BYOK.
#
# Memory: ~40 GB INT4 weights in a 47 GB slice leaves little KV headroom →
#   --max-model-len 8192 (conservative). KV-cache dtype left at default (auto) to
#   avoid AWQ+FP8-KV edge cases on the tightest slice.
#
# Build via ACR Tasks (large image — keep the long timeout):
#   az acr build --registry crjay --image kimi-dev-72b-vllm:latest \
#       --file Dockerfile.vllm.h100.mig --timeout 7200 .
# =============================================================================

FROM python:3.12.11-slim AS model-download
ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN uv pip install --system "huggingface_hub"
RUN hf download cyankiwi/Kimi-Dev-72B-AWQ-4bit \
        --local-dir /model/kimi-dev-72b

FROM vllm/vllm-openai:v0.20.1
LABEL org.opencontainers.image.title="Kimi-Dev-72B-AWQ vLLM Server (H100 MIG3g)" \
      org.opencontainers.image.description="Kimi-Dev-72B AWQ INT4 served via vLLM on an H100 3g.47gb MIG slice for the AKS inference-gateway test"

ENV MODEL_PATH=/model/kimi-dev-72b
# Model weights are split into one layer per safetensors shard (9 × ~4.4 GB)
# instead of a single ~40 GB COPY layer. A monolithic 40 GB layer cannot
# reliably finish the registry push inside the ACR Tasks push-step timeout: a
# single transient chunk failure forces a retry of the WHOLE 40 GB layer. Per-
# shard layers push concurrently (Docker pushes up to 5 at once) and a retry
# only re-uploads one ~4.4 GB shard.
COPY --from=model-download /model/kimi-dev-72b/model-00001-of-00009.safetensors /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/model-00002-of-00009.safetensors /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/model-00003-of-00009.safetensors /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/model-00004-of-00009.safetensors /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/model-00005-of-00009.safetensors /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/model-00006-of-00009.safetensors /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/model-00007-of-00009.safetensors /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/model-00008-of-00009.safetensors /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/model-00009-of-00009.safetensors /model/kimi-dev-72b/
# Config, tokenizer, index, and template files (small).
COPY --from=model-download /model/kimi-dev-72b/*.json /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/*.txt /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/*.jinja /model/kimi-dev-72b/
COPY --from=model-download /model/kimi-dev-72b/*.yaml /model/kimi-dev-72b/
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=8 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["vllm", "serve"]
CMD [ \
    "/model/kimi-dev-72b", \
    "--host", "0.0.0.0", \
    "--port", "8000", \
    "--served-model-name", "Kimi-Dev-72B", \
    "--quantization", "awq_marlin", \
    "--max-model-len", "8192", \
    "--gpu-memory-utilization", "0.95", \
    "--enable-auto-tool-choice", \
    "--tool-call-parser", "hermes", \
    "--trust-remote-code" \
]
