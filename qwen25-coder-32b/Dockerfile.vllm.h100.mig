# =============================================================================
# Dockerfile.vllm.h100.mig — Serve Qwen2.5-Coder-32B-Instruct-AWQ via vLLM on an
# H100 MIG slice (3g.47gb). Vendor-B model in the Kimi-vs-Qwen test (Option B).
#
# Qwen2.5-Coder-32B-Instruct-AWQ: official AWQ INT4 (~18 GB). Apache 2.0, ungated.
# served-model-name "Qwen2.5-Coder-32B". hermes tool-call parser for Copilot BYOK.
#
# Target slice: H100 94GB MIG profile 3g.47gb (~47 GB visible).
#   INT4 weights ~18 GB → ample KV headroom → --max-model-len 32768.
#
# Build via ACR Tasks:
#   az acr build --registry crjay --image qwen25-coder-32b-vllm:latest \
#       --file Dockerfile.vllm.h100.mig --timeout 7200 .
# =============================================================================

FROM python:3.12.11-slim AS model-download
ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN uv pip install --system "huggingface_hub"
RUN hf download Qwen/Qwen2.5-Coder-32B-Instruct-AWQ \
        --local-dir /model/qwen25-coder-32b

FROM vllm/vllm-openai:v0.20.1
LABEL org.opencontainers.image.title="Qwen2.5-Coder-32B-AWQ vLLM Server (H100 MIG3g)" \
      org.opencontainers.image.description="Qwen2.5-Coder-32B-Instruct-AWQ served via vLLM on an H100 3g.47gb MIG slice for the AKS inference-gateway test"

ENV MODEL_PATH=/model/qwen25-coder-32b
COPY --from=model-download /model/qwen25-coder-32b /model/qwen25-coder-32b
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=6 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["vllm", "serve"]
CMD [ \
    "/model/qwen25-coder-32b", \
    "--host", "0.0.0.0", \
    "--port", "8000", \
    "--served-model-name", "Qwen2.5-Coder-32B", \
    "--quantization", "awq_marlin", \
    "--max-model-len", "32768", \
    "--gpu-memory-utilization", "0.95", \
    "--enable-prefix-caching", \
    "--enable-auto-tool-choice", \
    "--tool-call-parser", "hermes", \
    "--trust-remote-code" \
]
