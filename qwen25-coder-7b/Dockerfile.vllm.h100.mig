# =============================================================================
# Dockerfile.vllm.h100.mig — Serve Qwen2.5-Coder-7B-Instruct via vLLM on an
# H100 MIG slice (2g.24gb). Agent/chat tier for the AKS inference-gateway test.
#
# Qwen2.5-Coder-7B-Instruct: 7B dense, BF16 ~15 GB. Apache 2.0, ungated.
# Tool calling (hermes parser) is REQUIRED for GitHub Copilot BYOK (CLI + agent).
#
# Target slice: H100 94GB MIG profile 2g.24gb (~24 GB visible to vLLM).
#   weights ~15 GB → ~7 GB KV headroom at 0.92 util → --max-model-len 32768.
#   (128k, which Copilot BYOK recommends, will NOT fit a 24 GB slice — use the
#    roomier MIG3g models in Option B for longer context.)
#
# served-model-name "Qwen2.5-Coder-7B" == the model id a client sends == the
# value the gateway HTTPRoute matches on X-Gateway-Model-Name.
#
# Build via ACR Tasks:
#   az acr build --registry crjay --image qwen25-coder-7b-vllm:latest \
#       --file Dockerfile.vllm.h100.mig --timeout 7200 .
# Optional HF token (avoids download rate limits):
#       --build-arg HF_TOKEN=hf_xxx
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: bake the model weights (~15 GB)
# ---------------------------------------------------------------------------
FROM python:3.12.11-slim AS model-download
ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN uv pip install --system "huggingface_hub"
RUN hf download Qwen/Qwen2.5-Coder-7B-Instruct \
        --local-dir /model/qwen25-coder-7b

# ---------------------------------------------------------------------------
# Stage 2: vLLM runtime
# ---------------------------------------------------------------------------
FROM vllm/vllm-openai:v0.20.1
LABEL org.opencontainers.image.title="Qwen2.5-Coder-7B vLLM Server (H100 MIG2g)" \
      org.opencontainers.image.description="Qwen2.5-Coder-7B-Instruct served via vLLM on an H100 2g.24gb MIG slice for the AKS inference-gateway test"

ENV MODEL_PATH=/model/qwen25-coder-7b
COPY --from=model-download /model/qwen25-coder-7b /model/qwen25-coder-7b
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["vllm", "serve"]
# Tool-calling flags are mandatory for Copilot BYOK; prefix caching reuses KV for
# shared system prompts / repo context (big win for coding agents). The runtime
# K8s Deployment still injects VLLM_API_KEY for endpoint auth.
CMD [ \
    "/model/qwen25-coder-7b", \
    "--host", "0.0.0.0", \
    "--port", "8000", \
    "--served-model-name", "Qwen2.5-Coder-7B", \
    "--max-model-len", "32768", \
    "--gpu-memory-utilization", "0.92", \
    "--enable-prefix-caching", \
    "--enable-auto-tool-choice", \
    "--tool-call-parser", "hermes", \
    "--trust-remote-code" \
]
