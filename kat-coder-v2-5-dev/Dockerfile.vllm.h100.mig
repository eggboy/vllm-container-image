# =============================================================================
# Dockerfile.vllm.h100.mig — Serve KAT-Coder-V2.5-Dev (AWQ INT4) via vLLM on
# one H100 MIG slice (3g.47gb profile). For shared-GPU deployments where
# several models each get a MIG partition. Replaces Kimi-Dev-72B-AWQ
# (2025-06; SWE-bench Verified 60.4).
#
# Why not a newer Kimi? Moonshot's entire 2026 catalog (Kimi-K2.6, K2.7-Code,
# K3, K3.1-Pro) is 1.0–2.8 T parameters (595–1560 GB) — nothing self-hostable
# on one GPU has shipped since Kimi-Dev-72B. KAT-Coder-V2.5-Dev (Kuaishou
# Kwaipilot, 2026-07-23, Apache-2.0) is the strongest SWE model that fits a
# 47 GB slice: Kwaipilot's numbers (Claude Code harness, pass@1, 256K ctx)
# SWE-bench Verified 69.4 / Multilingual 63.0 / Pro 46.0, Terminal-Bench 2.1
# 41.0 — versus 64.4 / 57.0 / 40.6 / 32.0 for Qwen3.6-35B-A3B in the same run.
# NOTE: it is a post-train of Qwen3.6-35B-A3B, i.e. it shares a backbone with
# the Qwen3.8-27B image (different vendor and training, same model family).
#
# Model: 35B-total / 3B-active MoE, hybrid Gated DeltaNet + Gated Attention,
# 262K native context. Checkpoint cyankiwi/KAT-Coder-V2.5-Dev-AWQ-INT4
# (~24.4 GB, compressed-tensors W4A16 asymmetric group-32; ONLY routed experts
# are INT4, the rest is float16). Ships language-model weights only (no vision
# tower, no MTP head) → --language-model-only is REQUIRED.
# served-model-name "KAT-Coder-V2.5-Dev" is the model id clients send.
#
# Memory (H100 94GB MIG profile 3g.47gb, ~47 GB ≈ 44–46 GiB visible):
#   - Weights:                                          ~23 GiB
#   - Activations (4192 batched tokens) + CUDA graphs:   ~1.5 GiB
#   - Budget at 0.95 utilization:                        ~42 GiB
#   - KV/GDN cache pool:                                 ~17 GiB
#   - Per-token pool cost ≈ 40 layers × 2 MiB GDN page / 2096 tokens ≈ 40–45 KB
#     → ~400K cached tokens → ~3 full 128K sequences resident (vs 8K context
#     for the 40 GB Kimi-Dev build on the same slice). --max-num-seqs 4 is a
#     scheduler cap; vLLM queues beyond what fits.
#
# vLLM runtime: v0.32.0. Marlin W4A16 MoE kernels run natively on H100 (SM90);
# the hybrid + Marlin KV page-size bug (#41153) was fixed by PR #37467 and is
# in this release.
#
# Build (downloads ~24 GB of weights into the image; allow time and disk):
#   docker build -f Dockerfile.vllm.h100.mig -t kat-coder-v2-5-dev-vllm:mig3g .
# Optional HF token (avoids download rate limits): --build-arg HF_TOKEN=hf_xxx
# Run on a MIG device (find the UUID with `nvidia-smi -L`):
#   docker run --gpus '"device=MIG-<uuid>"' --ipc=host -p 8000:8000 \
#       -e VLLM_API_KEY=change-me kat-coder-v2-5-dev-vllm:mig3g
# First start takes 5–15 min; /health returns 200 only when ready (see README.md).
# =============================================================================

FROM python:3.12.11-slim AS model-download
ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN uv pip install --system "huggingface_hub"
RUN hf download cyankiwi/KAT-Coder-V2.5-Dev-AWQ-INT4 \
        --local-dir /model/kat-coder-v2-5-dev

FROM vllm/vllm-openai:v0.32.0
LABEL org.opencontainers.image.title="KAT-Coder-V2.5-Dev AWQ-INT4 vLLM Server (H100 MIG 3g.47gb)" \
      org.opencontainers.image.description="KAT-Coder-V2.5-Dev (35B-A3B MoE, SWE post-train of Qwen3.6-35B-A3B) AWQ INT4 served via vLLM on one H100 3g.47gb MIG slice"

ENV MODEL_PATH=/model/kat-coder-v2-5-dev
# One image layer per ~5.4 GB shard (5 shards) instead of a single ~24 GB
# layer: a transient failure during the registry push only retries one shard,
# and layers upload in parallel.
COPY --from=model-download /model/kat-coder-v2-5-dev/model-00001-of-00005.safetensors /model/kat-coder-v2-5-dev/
COPY --from=model-download /model/kat-coder-v2-5-dev/model-00002-of-00005.safetensors /model/kat-coder-v2-5-dev/
COPY --from=model-download /model/kat-coder-v2-5-dev/model-00003-of-00005.safetensors /model/kat-coder-v2-5-dev/
COPY --from=model-download /model/kat-coder-v2-5-dev/model-00004-of-00005.safetensors /model/kat-coder-v2-5-dev/
COPY --from=model-download /model/kat-coder-v2-5-dev/model-00005-of-00005.safetensors /model/kat-coder-v2-5-dev/
# Config, tokenizer, index, and chat template files (small).
COPY --from=model-download /model/kat-coder-v2-5-dev/*.json  /model/kat-coder-v2-5-dev/
COPY --from=model-download /model/kat-coder-v2-5-dev/*.txt   /model/kat-coder-v2-5-dev/
COPY --from=model-download /model/kat-coder-v2-5-dev/*.jinja /model/kat-coder-v2-5-dev/
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=8 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["vllm", "serve"]
# --quantization compressed-tensors / --dtype float16: match the checkpoint.
# --language-model-only : REQUIRED (no vision weights in the checkpoint).
# --mamba-cache-mode align + --enable-chunked-prefill + --max-num-batched-tokens
#                         4192 (2 × hybrid Mamba block 2096): required combo for
#                         prefix caching on hybrid GDN models.
# --reasoning-parser qwen3 / --tool-call-parser qwen3_coder: per the KAT model
#                         card; tool calling is required by coding agents
#                         (e.g. Copilot BYOK).
# Set VLLM_API_KEY in the container environment to require a bearer token.
CMD [ \
    "/model/kat-coder-v2-5-dev", \
    "--host", "0.0.0.0", \
    "--port", "8000", \
    "--served-model-name", "KAT-Coder-V2.5-Dev", \
    "--quantization", "compressed-tensors", \
    "--dtype", "float16", \
    "--language-model-only", \
    "--kv-cache-dtype", "fp8", \
    "--max-model-len", "131072", \
    "--max-num-seqs", "4", \
    "--gpu-memory-utilization", "0.95", \
    "--enable-prefix-caching", \
    "--mamba-cache-mode", "align", \
    "--enable-chunked-prefill", \
    "--max-num-batched-tokens", "4192", \
    "--enable-auto-tool-choice", \
    "--reasoning-parser", "qwen3", \
    "--tool-call-parser", "qwen3_coder", \
    "--trust-remote-code" \
]
