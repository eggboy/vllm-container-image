# =============================================================================
# Dockerfile.vllm.h100.mig — Serve Qwen2.5-Coder-1.5B-Instruct via vLLM on an
# H100 MIG slice (2g.24gb). Fast / inline-completion tier for the test.
#
# Qwen2.5-Coder-1.5B-Instruct: 1.5B dense, BF16 ~3 GB. Apache 2.0, ungated.
# Tons of KV headroom in a 24 GB slice; tool calling enabled for Copilot BYOK.
# served-model-name "Qwen2.5-Coder-1.5B".
#
# Build via ACR Tasks:
#   az acr build --registry crjay --image qwen25-coder-1-5b-vllm:latest \
#       --file Dockerfile.vllm.h100.mig --timeout 7200 .
# =============================================================================

FROM python:3.12.11-slim AS model-download
ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN uv pip install --system "huggingface_hub"
RUN hf download Qwen/Qwen2.5-Coder-1.5B-Instruct \
        --local-dir /model/qwen25-coder-1-5b

FROM vllm/vllm-openai:v0.20.1
LABEL org.opencontainers.image.title="Qwen2.5-Coder-1.5B vLLM Server (H100 MIG2g)" \
      org.opencontainers.image.description="Qwen2.5-Coder-1.5B-Instruct served via vLLM on an H100 2g.24gb MIG slice for the AKS inference-gateway test"

ENV MODEL_PATH=/model/qwen25-coder-1-5b
COPY --from=model-download /model/qwen25-coder-1-5b /model/qwen25-coder-1-5b
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["vllm", "serve"]
CMD [ \
    "/model/qwen25-coder-1-5b", \
    "--host", "0.0.0.0", \
    "--port", "8000", \
    "--served-model-name", "Qwen2.5-Coder-1.5B", \
    "--max-model-len", "32768", \
    "--gpu-memory-utilization", "0.90", \
    "--enable-prefix-caching", \
    "--enable-auto-tool-choice", \
    "--tool-call-parser", "hermes", \
    "--trust-remote-code" \
]
